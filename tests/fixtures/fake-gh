#!/bin/bash
# テスト用の gh の代役。sync-pr-labels.sh が打つ 3 つの形だけを模す。
#
# - 呼び出しの引数を $TEST_TMPDIR/gh.calls へ記録する
# - `pr view` は $TEST_TMPDIR/pr.json を返す
# - `issue view <url>` は URL の末尾の番号 N について $TEST_TMPDIR/issue-N.json を返す。無ければ exit 1
# - `pr edit` は GH_STUB_EDIT_EXIT (既定 0) で終わる
set -euo pipefail

printf '%s\n' "$*" >>"$TEST_TMPDIR/gh.calls"

case "$1 $2" in
"pr view")
  cat "$TEST_TMPDIR/pr.json"
  ;;
"issue view")
  n="${3##*/}"
  if [ ! -f "$TEST_TMPDIR/issue-$n.json" ]; then
    printf 'fake-gh: issue %s not found\n' "$n" >&2
    exit 1
  fi
  cat "$TEST_TMPDIR/issue-$n.json"
  ;;
"pr edit")
  exit "${GH_STUB_EDIT_EXIT:-0}"
  ;;
*)
  printf 'fake-gh: unexpected call: %s\n' "$*" >&2
  exit 2
  ;;
esac
