#!/bin/bash
# テスト用の go の代役。`go build ... -o <path> ...` だけを模す。
#
# - 呼び出しの引数を $TEST_TMPDIR/go.calls へ、受け取った GOTOOLCHAIN を $TEST_TMPDIR/go.env へ記録する
# - <path> に、呼び出しを $TEST_TMPDIR/daemon.calls へ、GOTOOLCHAIN を $TEST_TMPDIR/daemon.env へ記録する fake daemon を作る
# - GO_STUB_OUTPUT があれば、その中身を stderr へ出す
# - GO_STUB_EXIT が 0 以外なら何も作らずその値で終わる
# - GO_STUB_WAIT_FOR が指すファイルが現れるまで終わらない (detach の検証用、最大 10 秒)
set -euo pipefail

printf '%s\n' "$*" >>"$TEST_TMPDIR/go.calls"
printf 'GOTOOLCHAIN=%s\n' "${GOTOOLCHAIN-unset}" >>"$TEST_TMPDIR/go.env"

if [ -n "${GO_STUB_OUTPUT:-}" ]; then
  printf '%s\n' "$GO_STUB_OUTPUT" >&2
fi

if [ -n "${GO_STUB_WAIT_FOR:-}" ]; then
  for ((i = 0; i < 200; i++)); do
    [ -e "$GO_STUB_WAIT_FOR" ] && break
    sleep 0.05
  done
fi

if [ "${GO_STUB_EXIT:-0}" != 0 ]; then
  exit "$GO_STUB_EXIT"
fi

out=""
while [ $# -gt 0 ]; do
  if [ "$1" = "-o" ]; then
    out="$2"
    shift
  fi
  shift
done
if [ -z "$out" ]; then
  printf 'fake-go: -o not given\n' >&2
  exit 2
fi

# shellcheck disable=SC2016 # 展開するのは書き出した script の側
printf '#!/bin/bash\nprintf "%%s\\n" "$*" >>"%s"\nprintf "GOTOOLCHAIN=%%s\\n" "${GOTOOLCHAIN-unset}" >>"%s"\n' \
  "$TEST_TMPDIR/daemon.calls" "$TEST_TMPDIR/daemon.env" >"$out"
chmod +x "$out"
