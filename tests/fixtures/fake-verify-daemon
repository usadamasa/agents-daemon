#!/bin/bash
# release-verify.bats 用の agents-daemon の代役。呼ばれた引数と、隔離の判定に使う環境変数を
# $TEST_TMPDIR/daemon.calls へ 1 行で記録する。TEST_TMPDIR は包み (fake-verify-go が書く) が渡す。
#
# - deps: stdin を読み捨てて JSON を出す。$TEST_TMPDIR/fail-deps があれば exit 3
# - daemon --foreground --dry-run: SIGTERM を受けるまで終わらない。受けたら exit 0
# - ほか: 空の JSON を出す
set -euo pipefail

printf '%s|HOME=%s|XDG_STATE_HOME=%s|CLAUDE_CONFIG_DIR=%s|REX_SERVER=%s|REX_SESSION=%s|REX_BLOCK=%s\n' \
  "$*" "${HOME-}" "${XDG_STATE_HOME-}" "${CLAUDE_CONFIG_DIR-}" "${REX_SERVER-}" "${REX_SESSION-}" "${REX_BLOCK-}" \
  >>"$TEST_TMPDIR/daemon.calls"

case "$*" in
  deps)
    cat >/dev/null
    if [ -e "$TEST_TMPDIR/fail-deps" ]; then
      exit 3
    fi
    printf '{"nodes":[]}\n'
    ;;
  "daemon --foreground --dry-run")
    trap 'exit 0' TERM
    while :; do
      sleep 0.1
    done
    ;;
  *)
    printf '{}\n'
    ;;
esac
